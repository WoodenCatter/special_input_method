<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- API credentials are Keystore-encrypted and must never leave this device. -->
    <exclude domain="sharedpref" path="personalization_credentials.xml" />
    <!-- Ear-EEG recordings and downloaded personalized models are sensitive and user-specific. -->
    <exclude domain="file" path="personalization/" />
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
-->
</full-backup-content>
